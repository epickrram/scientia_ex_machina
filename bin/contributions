#!/usr/bin/env python3
"""List the human's commits across every git repo under /src, for the journal.

Commits are matched by author (case-insensitive regex against "Name <email>", any of
several), across all branches, excluding merges, and filtered by author date so rebased
work lands on the day it was written. Output, per project with commits:

    ## <project>
    YYYY-MM-DD <sha> <subject> (+added -deleted, N files)

--identities instead prints "count Name <email> (projects)" per matching author, most
commits first, to confirm which identities belong to the human.
"""

import argparse
import collections
import os
import re
import subprocess
import sys
from pathlib import Path

RECORD = "\x1e"
FIELD = "\x1f"


def git_log(repo, since, authors, fields):
    command = ["git", "-C", str(repo), "log", "--all", "--no-merges", "--regexp-ignore-case",
               f"--since={since} 00:00", "--date=format:%Y-%m-%d",
               f"--format={RECORD}{FIELD.join(fields)}", "--shortstat"]
    command += [f"--author={author}" for author in authors]
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode != 0:
        return []
    return [record.strip().split("\n") for record in result.stdout.split(RECORD)[1:]]


def change_size(shortstat):
    added = re.search(r"(\d+) insertion", shortstat)
    deleted = re.search(r"(\d+) deletion", shortstat)
    files = re.search(r"(\d+) files? changed", shortstat)
    count = int(files.group(1)) if files else 0
    return (f"+{added.group(1) if added else 0} -{deleted.group(1) if deleted else 0}, "
            f"{count} file{'' if count == 1 else 's'}")


def repos(root):
    for path in sorted(root.iterdir()):
        if path.is_dir() and (path / ".git").exists():
            yield path


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--root", type=Path, default=Path(os.environ.get("SCIENTIA_SRC") or "/src"))
    parser.add_argument("--since", required=True, help="first author date, YYYY-MM-DD")
    parser.add_argument("--until", required=True, help="last author date, YYYY-MM-DD")
    parser.add_argument("--author", action="append", default=[],
                        help="author pattern; repeatable; default $SCIENTIA_AUTHORS (comma-separated)")
    parser.add_argument("--identities", action="store_true")
    args = parser.parse_args()

    authors = args.author or [a for a in os.environ.get("SCIENTIA_AUTHORS", "").split(",") if a]
    if not authors and not args.identities:
        parser.error("no author: pass --author or set SCIENTIA_AUTHORS")

    in_range = lambda date: args.since <= date <= args.until

    if args.identities:
        counts = collections.Counter()
        projects = collections.defaultdict(set)
        for repo in repos(args.root):
            for record in git_log(repo, args.since, authors, ["%ad", "%an <%ae>"]):
                date, identity = record[0].split(FIELD)
                if in_range(date):
                    counts[identity] += 1
                    projects[identity].add(repo.name)
        for identity, count in sorted(counts.items(), key=lambda item: (-item[1], item[0])):
            print(f"{count} {identity} ({', '.join(sorted(projects[identity]))})")
        return 0

    first = True
    for repo in repos(args.root):
        commits = []
        for record in git_log(repo, args.since, authors, ["%ad", "%h", "%s"]):
            date, sha, subject = record[0].split(FIELD, 2)
            if in_range(date):
                commits.append((date, sha, subject, change_size(" ".join(record[1:]))))
        if not commits:
            continue
        if not first:
            print()
        first = False
        print(f"## {repo.name}")
        # git log is newest first by commit date; sort by author date, stable within a day.
        for date, sha, subject, size in sorted(reversed(commits), key=lambda c: c[0]):
            print(f"{date} {sha} {subject} ({size})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
